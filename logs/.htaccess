# Deny all direct web access to this directory. Log files contain diagnostic
# data that must never be reachable over the web — inspect them via SFTP /
# the hosting file manager instead.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
