# Elma Real Estate CRM — environment configuration (placeholders only).
#
# Copy to .env (gitignored, web-blocked) for local overrides, or set the same
# variables in the server environment (Apache/LiteSpeed SetEnv, hPanel).
# Real environment variables take precedence over .env.
# Never commit real values.

# --- Database (required outside localhost; the app refuses to start without it)
CRM_DB_HOST=localhost
CRM_DB_PORT=3306
CRM_DB_NAME=your_crm_database
CRM_DB_USER=your_crm_db_user
CRM_DB_PASS=change-me

# --- Application
# Public base URL without trailing slash (auto-detected on web requests if empty)
CRM_BASE_URL=https://crm.example.com
CRM_BRAND_NAME=Elma Real Estate

# 32+ random characters; required before any secret is encrypted (future integrations)
CRM_ENCRYPTION_KEY=generate-a-long-random-string

# Comma-separated admin emails allowed into Route / Page Setup
CRM_SUPER_ADMIN_EMAILS=admin@example.com

# --- Mail (Gmail + app password). Overrides Basic Setup when both are set.
CRM_SMTP_USERNAME=mailer@example.com
CRM_SMTP_APP_PASSWORD=change-me

# --- Local development only: skips real OTP checks. Never enable in production.
CRM_DEV_MODE=0
